# Spring profile
# Use 'dev' for local development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev

# HTTP
PORT=8081
# For local development: http://localhost:5173
# For production: https://www.masukibooks.com
FRONTEND_URL=http://localhost:5173

# Database (Render/Supabase/Postgres)
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=your_database_password

# JPA
HIBERNATE_DDL_AUTO=validate

# JWT
JWT_SECRET=replace_with_a_secure_random_64_plus_char_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Admin bootstrap
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@masukibooks.com
BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password
BOOTSTRAP_ADMIN_FIRST_NAME=Super
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# Mail (optional in early staging)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Storage (Supabase S3-compatible)
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=books
S3_OBJECT_KEY_PREFIX=storage/manage/books
S3_MAX_FILE_SIZE=52428800
S3_PUBLIC_URL_PREFIX=https://your-project-ref.supabase.co/storage/v1/object/public/books

# Optional CORS additions, comma-separated
APP_EXTRA_ALLOWED_ORIGINS=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
