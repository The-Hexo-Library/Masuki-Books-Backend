{
  "baseUrl": "http://localhost:8081",
  "authHeader": "Authorization: Bearer <JWT_TOKEN>",
  "guestHeader": "X-Guest-Token: guest-12345",
  "endpoints": [
    { "method": "POST", "path": "/auth/register", "auth": "public", "payloadFile": "api-tests/payloads/auth-register.json" },
    { "method": "POST", "path": "/auth/login", "auth": "public", "payloadFile": "api-tests/payloads/auth-login.json" },
    { "method": "GET", "path": "/products", "auth": "public" },
    { "method": "POST", "path": "/products", "auth": "admin", "payloadFile": "api-tests/payloads/products-create.json" },
    { "method": "GET", "path": "/categories", "auth": "public" },
    { "method": "POST", "path": "/categories", "auth": "admin", "payloadFile": "api-tests/payloads/categories-create.json" },
    { "method": "POST", "path": "/cart/items", "auth": "optional", "payloadFile": "api-tests/payloads/cart-add-item.json" },
    { "method": "PUT", "path": "/cart/items/{cartItemId}", "auth": "optional", "payloadFile": "api-tests/payloads/cart-update-item.json" },
    { "method": "POST", "path": "/orders/checkout", "auth": "optional", "payloadFile": "api-tests/payloads/orders-checkout.json" },
    { "method": "POST", "path": "/payments/initiate", "auth": "user/admin", "payloadFile": "api-tests/payloads/payments-initiate.json" },
    { "method": "POST", "path": "/payments/callback", "auth": "public", "payloadFile": "api-tests/payloads/payments-callback.json" },
    { "method": "PATCH", "path": "/users/me", "auth": "user", "payloadFile": "api-tests/payloads/users-update-profile.json" },
    { "method": "POST", "path": "/users/me/change-password", "auth": "user", "payloadFile": "api-tests/payloads/users-change-password.json" },
    { "method": "POST", "path": "/wallet/topup", "auth": "user", "payloadFile": "api-tests/payloads/wallet-topup.json" },
    { "method": "POST", "path": "/reviews", "auth": "user", "payloadFile": "api-tests/payloads/reviews-submit.json" },
    { "method": "POST", "path": "/reader/{bookId}/progress", "auth": "user", "payloadFile": "api-tests/payloads/reader-save-progress.json" },
    { "method": "POST", "path": "/reader/{bookId}/bookmarks", "auth": "user", "payloadFile": "api-tests/payloads/reader-create-bookmark.json" },
    { "method": "POST", "path": "/support-tickets", "auth": "user", "payloadFile": "api-tests/payloads/support-ticket-create.json" },
    { "method": "POST", "path": "/resale/list", "auth": "user", "payloadFile": "api-tests/payloads/resale-list.json" },
    { "method": "POST", "path": "/admin/discounts", "auth": "admin", "payloadFile": "api-tests/payloads/admin-discount-create.json" }
  ]
}
